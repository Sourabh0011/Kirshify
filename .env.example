# Copy this file to .env.local and fill in real values.
# Nothing here is required to run the UI — the app ships with in-memory mock data.

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend (planned) ---
# MongoDB Atlas connection string (replaces src/server/data mock repositories)
MONGODB_URI=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Gemini (AI advisory) — used by src/app/api/v1/advisor
GEMINI_API_KEY=

# Agmarknet / data.gov.in API key (live mandi prices)
AGMARKNET_API_KEY=

# FastAPI disease-detection service (ResNet-50 / MobileNet)
DISEASE_API_URL=
